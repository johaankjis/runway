# FastAPI
RUNWAY_API_HOST=0.0.0.0
RUNWAY_API_PORT=8000
RUNWAY_CORS_ORIGINS=http://localhost:3000

# Next.js
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# AI providers (fixture mode needs no credentials)
RUNWAY_SIGNAL_PROVIDER=fixture
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
NVIDIA_TIMEOUT_SECONDS=20

RUNWAY_VOICE_PROVIDER=fixture
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_TIMEOUT_SECONDS=20
